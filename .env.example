# ==================================
# Motion Studio Pro - Environment Variables
# ==================================
# Copy this file to .env and fill in your actual credentials
# NEVER commit your .env file to version control!

# ==================================
# Kling AI API Configuration
# ==================================
# Get your API credentials from: https://klingai.com/
# 1. Create an account
# 2. Go to API Settings
# 3. Generate your Access Key and Secret Key
VITE_KLING_ACCESS_KEY=your_kling_access_key_here
VITE_KLING_SECRET_KEY=your_kling_secret_key_here

# API Base URL
# - For LOCAL development: http://localhost:3001/api/v1
# - For PRODUCTION (Vercel): /api/kling
VITE_KLING_API_BASE_URL=/api/kling

# ==================================
# Supabase Configuration
# ==================================
# Get your Supabase credentials from: https://supabase.com/
# 1. Create a new project (free tier available)
# 2. Go to Settings → API
# 3. Copy your Project URL and anon/public key

# Your Supabase project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase anonymous/public key (safe to expose to frontend)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ==================================
# Optional: Local Development
# ==================================
# Only needed if using local proxy server (server.js)
# PUBLIC_URL=http://localhost:3001

# ==================================
# IMPORTANT NOTES:
# ==================================
# 1. All variables starting with VITE_ are exposed to the frontend
# 2. Never share your .env file publicly
# 3. For production deployment (Vercel, Railway, etc.), add these variables
#    to your hosting platform's environment variables section
# 4. The Kling API keys are used server-side (in api/kling.ts) to generate
#    JWT tokens - they're never directly exposed to the browser
# 5. Make sure to run the database migrations before starting:
#    - supabase/migrations/20260131_initial_schema.sql
#    - supabase/migrations/20260131_create_storage_buckets.sql
